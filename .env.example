APP_ENV=local
APP_NAME=PashuSetu API
API_V1_PREFIX=/api/v1
DATABASE_URL=postgresql+psycopg://pashusetu:pashusetu@db:5432/pashusetu
JWT_SECRET=change-me-in-real-environments
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_TEST_MODE=false
DATABASE_ISOLATED_FOR_QA=false
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
CORS_ORIGIN_REGEX=^https?://(localhost|127\.0\.0\.1)(:\d+)?$
