APP_ENV=local
APP_NAME=PashuSetu API
API_V1_PREFIX=/api/v1
DATABASE_URL=postgresql+psycopg://pashusetu:pashusetu@db:5432/pashusetu
JWT_SECRET=change-me-in-real-environments
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
DEVELOPMENT_OTP_SEED=pashusetu-dev-otp-v1
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
